# Copy to .env and fill in ONE provider's key. Never commit .env.
# If only OPENAI_API_KEY is set, the agent uses OpenAI automatically.

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=
# EFFORT=medium                 # low | medium | high
# ANTHROPIC_FALLBACKS=1         # server-side refusal fallback; 0 disables it

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_TEMPERATURE=0          # only sent when set; some models reject it
# OPENAI_REASONING_EFFORT=      # only for reasoning models: low | medium | high

# --- Optional overrides ---
# PROVIDER=openai               # anthropic | openai (auto-detected from the key if unset)
# MODEL=gpt-4.1                 # default: claude-sonnet-5-5 (anthropic) or gpt-4.1 (openai)
# JUDGE_MODEL=                  # default: same as MODEL
# PROMPT_VERSION=v3               # final prompt (default); v1 and v2 kept for comparison

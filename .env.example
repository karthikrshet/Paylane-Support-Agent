# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
# Agent model (default claude-sonnet-5-5) and effort (low | medium | high)
MODEL=claude-sonnet-5-5
EFFORT=medium
JUDGE_MODEL=claude-sonnet-5-5
PROMPT_VERSION=v1
# Server-side refusal fallback on the Claude API; 0 disables it
ANTHROPIC_FALLBACKS=1
